# === Required ===
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mail?schema=public
REDIS_URL=redis://redis:6379

# === Application ===
NODE_ENV=production
PORT=3000
APP_HOST=0.0.0.0
CLIENT_URL=http://localhost:18300

# === Auth ===
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# === Admin ===
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# === Email (SMTP) ===
# Leave empty to use per-mailbox SMTP settings
SMTP_HOST=
SMTP_PORT=18125
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_DEFAULT_FROM=noreply@example.com

# === S3 / Attachments ===
# Leave empty to use local filesystem fallback
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# === TURN (WebRTC) ===
TURN_SECRET=
TURN_REALM=isotopiq.local
TURN_TTL=86400
TURN_PORT=18478

# === Mailpit (dev only) ===
# Set to "mailpit" when using docker-compose, "localhost" for local dev
MAILPIT_HOST=mailpit
MAILPIT_SMTP_PORT=18125
MAILPIT_IMAP_PORT=18143

# === Port Mapping (host-side) ===
# App:       18300 -> 3000
# Mailpit:   18025 (web), 18125 (SMTP)
# PostgreSQL: 18543 -> 5432 (dev only)
# Redis:     18379 -> 6379 (dev only)
# coturn:    18478 (TURN/STUN)
